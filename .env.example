# Copie para .env e preencha. Nunca publique o .env.

# Discord (veja docs/discord.md)
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=

# Como o Kai te chama e o seu fuso horário
KAI_NOME_DONO=
KAI_FUSO=America/Sao_Paulo

# Clima no briefing ({clima} nas rotinas). País com 2 letras (opcional).
KAI_CIDADE=
KAI_PAIS=BR

# Canal onde tudo vira ideia, sem precisar mencionar o Kai (vazio = desliga)
KAI_CANAL_IDEIAS=ideias

# Transcrição de áudio (docker compose up -d whisper). Vazio = desliga.
KAI_WHISPER_URL=

# Pasta de notas com git (ex.: um vault do Obsidian). O Kai faz pull antes e push depois. Vazio = desliga.
KAI_NOTAS_GIT=

# Opcionais
# KAI_PERSONA=./persona            # pasta com o CLAUDE.md
# KAI_DADOS=./dados                # sessões, lembretes e anexos
# KAI_ROTINAS=./config/rotinas.json
# KAI_PERMISSION_MODE=auto         # modo de permissão do Claude Code (auto | acceptEdits | default)
# KAI_TIMEOUT_MIN=5
